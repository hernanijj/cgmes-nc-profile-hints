aec:AssessedElementWithRemedialAction-dangglingReference
	rdf:type 		sh:PropertyShape ;
	sh:description	"This constraint validates the danggling reference between AE and RA." ;	
	sh:or 			( 
						[ sh:class nc:GridStateAlterationRemedialAction ]
						[ sh:class nc:RedispatchRemedialAction ]
						[ sh:class nc:AvailabilityRemedialAction ]
						[ sh:class nc:SchemeRemedialAction ]
					) ;
	sh:message		"The AssessedElementWithRemedialAction has an mRID that does not exist in the RemedialAction RDF file." ;
	sh:name         "AssessedElementWithRemedialAction-dangglingReference" ;
	sh:nodeKind     sh:IRI ;
	sh:path			nc:AssessedElementWithRemedialAction.RemedialAction ;
	sh:severity 	sh:Violation .	
	
aec:AssessedElementWithRemedialAction-dangglingReferenceNodeShape
	rdf:type		sh:NodeShape ;
	sh:property		aec:AssessedElementWithRemedialAction-dangglingReference ;
	sh:targetClass	nc:AssessedElementWithRemedialAction .


aec:AssessedElementWithContingency-dangglingReference
	rdf:type 		sh:PropertyShape ;
	sh:description	"This constraint validates the danggling reference between AE and CO." ;	
	sh:or 			( 
						[ sh:class nc:OutOfRangeContingency ]
						[ sh:class nc:OrdinaryContingency ]
						[ sh:class nc:ExceptionalContingency ]
					) ;
	sh:message		"The AssessedElementWithContingency has an mRID that does not exist in the Contingency RDF file." ;
	sh:name         "AssessedElementWithContingency-dangglingReference" ;
	sh:nodeKind     sh:IRI ;
	sh:path			nc:AssessedElementWithContingency.Contingency ;
	sh:severity 	sh:Violation .	
	
aec:AssessedElementWithContingency-dangglingReferenceNodeShape
	rdf:type		sh:NodeShape ;
	sh:property		aec:AssessedElementWithContingency-dangglingReference ;
	sh:targetClass	nc:AssessedElementWithContingency .	