@prefix eu:    <http://iec.ch/TC57/CIM100-European#> .
@prefix cims:  <http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix cim:   <http://iec.ch/TC57/CIM100#> .
@prefix rac:  <http://entsoe.eu/ns/CIM/RemedialAction-EU/CustomConstraints#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dash:  <http://datashapes.org/dash#> .
@prefix dcterms:    <http://purl.org/dc/terms#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix nc:      <http://entsoe.eu/ns/nc#> .


rac:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1" , "file://iec61970cim17v40_iec61968cim13v13a_iec62325cim03v17a.eap" ;
        dcterms:creator           "Hernani TSCNET"@en ;
        dcterms:description       "The custom constraints for the RemedialAction profile."@en ;
        dcterms:identifier        "urn:uuid:e097e7dd-198c-6f2a-bb7f-d2a4db6191a4" ;
        dcterms:issued            "2024-08-22T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2022-09-28"^^xsd:date ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "HernaniJusto"@en ;
        dcterms:title             "RemedialAction profile custom constraints"@en ;
        owl:versionIRI        <http://entsoe.eu/ns/CIM/RemedialAction-EU/CustomConstraints/2.1> ;
		dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        dcat:theme            "constraints"@en .

cim:    
    a           owl:Ontology ;
    owl:imports sh: ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://iec.ch/TC57/CIM100#"^^xsd:anyURI ;
        sh:prefix "cim" ;
    ] ;
	sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://entsoe.eu/ns/nc#"^^xsd:anyURI ;
        sh:prefix "nc" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
        sh:prefix "rdf" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://iec.ch/TC57/CIM100-European#"^^xsd:anyURI ;
        sh:prefix "eu" ;
    ] .


rac:RAgroup
        a           sh:PropertyGroup ;
        rdfs:label  "RemedialActionGroup" ;
        sh:order    0 .
		

rac:ContingencyWithRemedialAction-dangglingReference
	rdf:type 		sh:PropertyShape ;
	sh:description	"This constraint validates the danggling reference between CO and RA." ;	
	sh:or 			( 
						[ sh:class nc:OutOfRangeContingency ]
						[ sh:class nc:OrdinaryContingency ]
						[ sh:class nc:ExceptionalContingency ]
					) ;
	sh:message		"The ContingencyWithRemedialAction has an mRID that does not exist in the Contingency RDF file." ;
	sh:name         "ContingencyWithRemedialAction-dangglingReference" ;
	sh:nodeKind     sh:IRI ;
	sh:path			nc:ContingencyWithRemedialAction.Contingency ;
	sh:severity 	sh:Violation .	
	
rac:ContingencyWithRemedialAction-dangglingReferenceNodeShape
	rdf:type		sh:NodeShape ;
	sh:property		rac:ContingencyWithRemedialAction-dangglingReference ;
	sh:targetClass	nc:ContingencyWithRemedialAction .


rac:PowerBidSchedulePowerRemedialAction-dangglingReference
	rdf:type 		sh:PropertyShape ;
	sh:description	"This constraint validates the danggling reference between SIS and RA." ;	
	sh:or 			( 
						[ sh:class nc:RedispatchRemedialAction ]
						[ sh:class nc:CountertradeRemedialAction ]
					) ;
	sh:message		"The PowerBidSchedule.PowerRemedialAction has an mRID that does not exist in the RemedialAction RDF file." ;
	sh:name         "PowerBidSchedulePowerRemedialAction-dangglingReference" ;
	sh:nodeKind     sh:IRI ;
	sh:path			nc:PowerBidSchedule.PowerRemedialAction ;
	sh:severity 	sh:Violation .	
	
rac:PowerBidSchedulePowerRemedialAction-dangglingReferenceNodeShape
	rdf:type		sh:NodeShape ;
	sh:property		rac:PowerBidSchedulePowerRemedialAction-dangglingReference ;
	sh:targetClass	nc:PowerBidSchedule .

